@using Ecommerce.DataModels.Models
@model IEnumerable<Order>
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-primary bg-gradient mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Order Details</h2>
            </div>
        </div>
    </div>
    @if (Model != null && Model.Count() > 0)
    {
        <div class="card-body p-4 mb-4">
            <a href="/Identity/Account/Manage" class="btn btn-primary">Back</a>
            <table id="orderDetails" class="table table-bordered table-striped " style="width:100%">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Order Date</th>
                        <th>Order Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.ID</td>
                            <td>@order.OrderDate.ToString("dd-MM-yyyy")</td>
                            @if(order.OrderDetails!=null && order.OrderDetails.Count()>0)
                            {
                               <td>
                                    <table id="orderDetails" class="table table-bordered table-striped " style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Order ID</th>
                                                <th>Unit Price</th>
                                                <th>Quantity</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var orderdet in order.OrderDetails)
                                            {
                                                <tr>
                                                    <td>@orderdet.ID</td>
                                                    <td>@orderdet.UnitPrice</td>
                                                    <td>@orderdet.Quantity</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                               </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body p-4 mb-4">
            <p class="text-center">No orders found.</p>
        </div>
    }
</div>
