@using Ecommerce.DataModels.Models
@model IEnumerable<Product>

<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Search products..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div class="row pb-3">
    @foreach (var product in Model)
    {
        <div class="col-lg-3 col-sm-6">
            <div class="row p-2">
                <div class="col-12 p-1">
                    <div class="card border-0 p-3 shadow border-top border-5 rounded">
                        <img src="@product.ImageUrl" class="card-img-top rounded" />
                        <div class="card-body pb-0">
                            <div class="pl-1 mb-0">
                                <p class="card-title h5 text-dark opacity-75 text-uppercase text-center">@product.Name</p>
                            </div>
                            <div class="pl-1 mb-0">
                                <p class="card-title text-dark opacity-75 text-center">Description: @product.Description</p>
                            </div>
                            <div class="pl-1 mb-0">
                                <p class="text-dark text-opacity-75 text-center">List Price: <span class="text-decoration-line-through">@product.Price</span></p>
                            </div>
                            <div class="pl-1 mb-0">
                                <p class="text-dark text-opacity-75 text-center">As low as:<span> @product.Discount.ToString()</span></p>
                            </div>
                        </div>
                        <div>
                            @* <a onclick="add(@product.ID)" asp-action="Details" asp-route-productId="@product.ID"
                               class=" btn btn-primary bg-gradient border-0 form-control">Details</a> *@
                            <a onclick="add(@product.ID)" 
                               class=" btn btn-primary bg-gradient border-0 form-control">Details</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }

</div>

@section Scripts {
    <script>
        async function add(productId) {

            var userNameEl = document.getElementById("userName");
            if (userNameEl == null) {
                window.location.href = '/Identity/Account/Login';
            }
            else{
                 window.location.href = 'Customer/Home/Details?productId=' + productId;
            }
           
        }
    </script>
}