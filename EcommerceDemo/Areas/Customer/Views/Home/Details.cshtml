@using Ecommerce.DataModels.Models
@model Product 
<form method="post">
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-primary bg-gradient text-light py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h5 class="text-white text-uppercase">@Model.Name</h5>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="py-3">
                <div class="row">
                    <div class="col-6 col-md-2 offset-lg-1 pb-1">
                        <a asp-action="Index" class="btn btn-outline-primary bg-gradient mb-5 fw-semibold btn-sm text-uppercase">
                            <small>Back to home</small>
                        </a>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-lg-3 offset-lg-1 text-center mb-3">
                        <img src="@Model.ImageUrl" width="100%" class="rounded" />
                    </div>
                    <div class="col-12 col-lg-6 offset-lg-1">

                        <div class="col-12 col-md-6 pb-4">
                            <span class="badge">@Model.Category.Name</span>
                        </div>
                        <div class="row ps-2">
                            <h6 class="text-dark text-opacity-50 ">Description : @Model.Description</h6>
                        </div>
                        <div class="row ps-2">
                            <h6 class="text-dark text-opacity-50  pb-2">
                                List Price:@Model.Price
                                <span class="text-decoration-line-through">
                                    List Price:@Model.Discount
                                </span>
                            </h6>
                        </div>
                        <div class="row text-center ps-2">
                           Customization
                        </div>
                        <div class="row text-center ps-2">
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <div class="text-dark text-opacity-50 fw-semibold">Width:</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <input type="radio" id="width1" name="SelectedWidth" value="@Model.ProductDetails.Width1" />
                                <label for="Width1">@Model.ProductDetails.Width1</label>
                               @*  <div class="text-dark text-opacity-50 fw-semibold">@Model.ProductDetails.Width1</div> *@
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <input type="radio" id="width2" name="SelectedWidth" value="@Model.ProductDetails.Width2" />
                                <label for="Width2">@Model.ProductDetails.Width2</label>
                          @*       <div class="text-dark text-opacity-50 fw-semibold">@Model.ProductDetails.Width2</div> *@
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <input type="radio" id="width3" name="SelectedWidth" value="@Model.ProductDetails.Width3" />
                                <label for="Width3">@Model.ProductDetails.Width3</label>
                                @* <div class="text-dark text-opacity-50 fw-semibold">@Model.ProductDetails.Width3</div> *@
                            </div>
                        </div>
                        <div class="row text-center ps-2">
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <div>Color:</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <input type="radio" id="GripColour1" name="SelectedColor" value="@Model.ProductDetails.GripColour1" />
                                <label for="GripColour1">@Model.ProductDetails.GripColour1</label>
                                @* <div>@Model.ProductDetails.GripColour1</div> *@
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <input type="radio" id="GripColour2" name="SelectedColor" value="@Model.ProductDetails.GripColour2" />
                                <label for="GripColour2">@Model.ProductDetails.GripColour2</label>
                              @*   <div>@Model.ProductDetails.GripColour2</div> *@
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <input type="radio" id="GripColour3" name="SelectedColor" value="@Model.ProductDetails.GripColour3" />
                                <label for="GripColour3">@Model.ProductDetails.GripColour3</label>
                              @*   <div>@Model.ProductDetails.GripColour3</div> *@
                            </div>
                        </div>
                        <div class="row pl-2 my-3">
                            <p class="text-secondary lh-sm">Description</p>
                        </div>
                        <div class="row pl-2 mb-3">
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <span class="input-group-text bg-primary text-white border-0 fw-semibold"
                                          id="inputGroup-sizing-default">
                                        Count
                                    </span>
                                    <input type="number" value="1" class="form-control text-end"
                                           aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" />

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-6 pb-1">
                                <button type="submit" onclick="add(@Model.ID)" class="btn btn-primary bg-gradient  w-100 py-2 text-uppercase fw-semibold">
                                    Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts{
    <script>
                async function add(productId) {
            try {
                var response = await fetch(`/Customer/Cart/AddItem?productId=${productId}`);
                if (response.ok) {
                    var result = await response.json();
                    var cartItemCount = document.getElementById("cartCount");
                    if (cartItemCount) {
                        cartItemCount.innerHTML = result;
                    }
                } else {
                    console.log("Failed to add item to cart.");
                }
            } catch (err) {
                console.log(err);
            }
        }
    </script>
}
