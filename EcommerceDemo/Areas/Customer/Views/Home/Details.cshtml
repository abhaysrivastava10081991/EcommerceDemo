@using Ecommerce.DataModels.Models
@model Product
<form method="post">
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-primary bg-gradient text-light py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h5 class="text-white text-uppercase">@Model.Name</h5>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="py-3">
                <div class="row">
                    <div class="col-6 col-md-2 offset-lg-1 pb-1">
                        <a asp-action="Index" class="btn btn-outline-primary bg-gradient mb-5 fw-semibold btn-sm text-uppercase">
                            <small>Back to home</small>
                        </a>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-lg-3 offset-lg-1 text-center mb-3">
                        <img src="@Model.ImageUrl" width="100%" class="rounded" />
                    </div>
                    <div class="col-12 col-lg-6 offset-lg-1">

                        <div class="col-12 col-md-6 pb-4">
                            <span class="badge">@Model.Category.Name</span>
                        </div>
                        <div class="row ps-2">
                            <h6 class="text-dark text-opacity-50 ">Description : @Model.Description</h6>
                        </div>
                        <div class="row ps-2">
                            <h6 class="text-dark text-opacity-50  pb-2">
                                List Price:@Model.Price
                                <span class="text-decoration-line-through">
                                    List Price:@Model.Discount
                                </span>
                            </h6>
                        </div>
                        <div class="row text-center ps-2">
                            Customization
                        </div>
                        <div class="row text-center ps-2">
                            <div class="p-1  bg-white border-bottom">
                                <div class="text-dark text-opacity-50 fw-semibold">Size:</div>
                            </div>
                            <div class="p-1 bg-white border-bottom">
                                <input type="radio" name="Size" value="Option1" id="option1" />
                                <label for="option1">SH</label>

                                <input type="radio" name="Size" value="Option2" id="option2" />
                                <label for="option2">Harrow</label>

                                <input type="radio" name="Size" value="Option3" id="option3" />
                                <label for="option3">6</label>
                               
                            </div>
                            
                        </div>
                        <div class="row text-center ps-2">
                            <div class="p-1 bg-white fw-bold">
                                <div>Weight:</div>
                            </div>
                            <div class="p-1 bg-white fw-bold">
                                <input type="radio" name="Width" value="Option1" id="option1" />
                                <label for="option1">2lb 7oz - 8oz | Very Light (1110 - 1150g)</label><br />

                                <input type="radio" name="Width" value="Option2" id="option2" />
                                <label for="option2">2lb 9oz - 10oz | Light (1150 - 1190g)</label><br />

                                <input type="radio" name="Width" value="Option3" id="option3" />
                                <label for="option2">2lb 11oz - 12oz | Medium (1190 - 1250g)</label><br />

                                <input type="radio" name="Width" value="Option3" id="option3" />
                                <label for="option2">2lb 13oz + | Heavy (1250 g +)</label>
                               
                            </div>
                        </div>
                        <div class="row pl-2 my-3">
                            <p class="text-secondary lh-sm">Description</p>
                        </div>
                        <div class="row pl-2 mb-3">
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <span class="input-group-text bg-primary text-white border-0 fw-semibold"
                                          id="inputGroup-sizing-default">
                                        Count
                                    </span>
                                    <input type="number" name="count" id="count" value="1" class="form-control text-end"
                                           aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" />

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-6 pb-1">
                                <button type="submit" onclick="add(@Model.ID,@Model.Price,
            getSelectedRadioValue('Size'),
            getSelectedRadioValue('Width'),getCount())" class="btn btn-primary bg-gradient  w-100 py-2 text-uppercase fw-semibold">
                                    Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        async function add(productId,unitPrice,size,weight,qty) {

            var userNameEl = document.getElementById("userName");
            if (userNameEl == null) {
                window.location.href = '/Identity/Account/Login';
            }
            try {
                var response = await fetch(`/Customer/Cart/AddItem?productId=${productId}&unitPrice=${unitPrice}&size=${size}&weight=${weight}&qty=${qty}`);
                if (response.ok) {
                    var result = await response.json();
                    var cartItemCount = document.getElementById("cartCount");
                    if (cartItemCount) {
                        cartItemCount.innerHTML = result;
                        window.location.href = "#cartCount";
                    }
                } else {
                    console.log("Failed to add item to cart.");
                }
            } catch (err) {
                console.log(err);
            }
        }
    </script>

    <script>
                function getSelectedRadioValue(name) {
            var radios = document.getElementsByName(name);
            for (var i = 0; i < radios.length; i++) {
                if (radios[i].checked) {
                    return radios[i].value;
                }
            }
            return null;
        }

        function getCount() {
            return document.getElementById("count").value;
        }

    </script>
}
