@using Ecommerce.DataModels.Models
@model List<Product>
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-primary bg-gradient mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Product List</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4 mb-4">
        <div class="row pb-3">
            <div class="col-6"></div>
            <div class="col-6 text-end">
                <a asp-controller="Product" asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle p-2"></i>Create New Product
                </a>
            </div>
        </div>
        <table id="productDetails" class="table table-bordered table-striped " style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Discount</th>
                    <th>Category</th>
                </tr>
            </thead>
            <tbody>
                @* @foreach (var item in Model.OrderBy(d => d.Name))
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.Price</td>
                        <td>@item.Discount</td>
                        <td>@item.Category.Name</td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Product" asp-action="Upsert" asp-route-id="@item.ID" class="btn btn-primary">Edit</a>
                                <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                } *@
            </tbody>
        </table>
    </div>
</div>

@section scripts
{
    <script src="~/js/product.js"></script>
}
